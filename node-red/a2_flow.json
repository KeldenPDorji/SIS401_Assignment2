 {
  "id": "fnTB",
  "type": "function",
  "z": "a2flow",
  "name": "Format for ThingsBoard",
  "func": "// Map each local topic onto flat ThingsBoard telemetry keys\nconst p = msg.payload;\nswitch (msg.topic) {\n  case 'assignment2/sensors/data':\n    msg.payload = { temperature: Number(p.temperature), humidity: Number(p.humidity), light: Number(p.light) };\n    break;\n  case 'assignment2/ai/classification':\n    msg.payload = { ai_label: p.label, ai_confidence: Number(p.confidence) };\n    break;\n  case 'assignment2/actuator/state':\n    msg.payload = { servo_angle: Number(p.servo), led_on: p.led === true };\n    break;\n  default:\n    return null;\n}\nmsg.topic = 'v1/devices/me/telemetry';\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 470,
  "y": 540,
  "wires": [
   [
    "outTB"
   ]
  ]
 },
