  "z": "a2flow",
  "name": "ThingsBoard telemetry",
  "topic": "v1/devices/me/telemetry",
  "qos": "1",
  "retain": "false",
  "respTopic": "",
  "contentType": "",
  "userProps": "",
  "correl": "",
  "expiry": "",
