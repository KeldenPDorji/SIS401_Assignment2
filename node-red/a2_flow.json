 {
  "id": "fnAI",
  "type": "function",
  "z": "a2flow",
  "name": "Format AI result",
  "func": "const p = msg.payload;\nmsg.payload = p.label + '  (' + Math.round(Number(p.confidence) * 100) + '%)';\nreturn msg;",
  "outputs": 1,
