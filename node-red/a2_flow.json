    "fnTB"
   ]
  ]
 },
 {
  "id": "fnSplit",
  "type": "function",
  "z": "a2flow",
  "name": "Split sensor JSON",
  "func": "// One JSON message in, one message per sensor out (gauges + chart series)\nconst d = msg.payload;\nconst t = { topic: 'Temperature (°C)', payload: Number(d.temperature) };\nconst h = { topic: 'Humidity (%)',     payload: Number(d.humidity) };\nconst l = { topic: 'Light (%)',        payload: Number(d.light) };\nreturn [[t], [h], [l], [t, h, l]];",
  "outputs": 4,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 470,
  "y": 80,
  "wires": [
   [
    "gTemp"
   ],
   [
    "gHum"
   ],
   [
    "gLight"
   ],
   [
    "chart"
   ]
  ]
 },
